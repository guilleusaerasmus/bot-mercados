# Copia este archivo como .env y rellena tus claves. El .env NUNCA se sube a GitHub.

# --- IA ---
# Proveedor: groq (plan gratuito, recomendado) o xai (Grok, de pago tras los créditos de prueba)
LLM_PROVIDER=groq
# Clave de https://console.groq.com/keys (o de https://console.x.ai si usas xai)
LLM_API_KEY=
# Opcional. Modelos por orden de preferencia: si uno agota su cupo gratuito se usa el siguiente.
# Por defecto con groq: openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b. Obligatorio con xai (ver https://docs.x.ai)
LLM_MODELS=
# Esfuerzo de razonamiento de los modelos gpt-oss: low (gasta menos tokens), medium o high
LLM_REASONING_EFFORT=low
# Opcional: modelo de voz a texto para las notas de voz (con groq: whisper-large-v3-turbo; con xai no hay)
STT_MODEL=

# --- Documentos (RAG) ---
# Identificación ante la SEC para descargar informes anuales 10-K: nombre y un email de contacto,
# p. ej. "Bot de Mercados tu_email@dominio.com". Vacío = sin informes de la SEC (los PDFs siguen funcionando)
SEC_USER_AGENT=
# true = búsqueda híbrida (embeddings locales + BM25); false = solo palabras clave
RAG_EMBEDDINGS=true
# Opcional: carpeta del modelo de embeddings (~250 MB). Por defecto ~/.bot-mercados/modelos
MODELS_DIR=

# --- Telegram ---
# Token que te da @BotFather (solo para el modo telegram)
TELEGRAM_TOKEN=
# Tu ID de Telegram (@userinfobot te lo dice): acceso a /stats, /regalar, /reembolsar y sin límites
ADMIN_USER_IDS=
# Opcional: si lo rellenas, SOLO estos IDs pueden usar el bot (modo privado para pruebas). Vacío = público
ALLOWED_USER_IDS=
# Opcional: canal donde publicar el resumen diario (@nombre_del_canal). El bot debe ser administrador del canal
CHANNEL_ID=

# --- Negocio ---
# Precio de Premium en Telegram Stars cada 30 días (1-10000)
PREMIUM_PRICE_STARS=250
# Contacto que se muestra en /paysupport (p. ej. tu @usuario o un email de soporte)
SUPPORT_CONTACT=
# Hora (España) del resumen diario de los días laborables
DAILY_SUMMARY_TIME=18:00
# Opcional: dónde guardar la base de datos (por defecto ~/.bot-mercados/bot.db, fuera de OneDrive)
DB_PATH=
